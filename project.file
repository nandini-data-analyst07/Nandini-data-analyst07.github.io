<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Project Details | Nandini Kumari</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:"Segoe UI",Arial,sans-serif;background:radial-gradient(circle at 20% 10%,#28172f 0%,transparent 28%),radial-gradient(circle at 90% 70%,#21152d 0%,transparent 25%),#090a0f;color:#eee;line-height:1.6}
a{color:inherit;text-decoration:none}
.container{max-width:900px;margin:40px auto;padding:0 20px}
.back-btn{display:inline-block;margin-bottom:25px;padding:8px 16px;background:#14131a;border:1px solid #554454;border-radius:8px;color:#e6b3df;font-size:13px}
.back-btn:hover{background:#291b2b}
.card{background:rgba(11,12,17,.86);border:1px solid #36303b;border-radius:18px;padding:35px;box-shadow:0 0 35px rgba(190,80,200,.08)}
.project-tag{color:#96648e;font-size:12px;letter-spacing:1px;font-weight:bold}
h1{font-size:32px;color:#e8e4e8;margin:10px 0 15px}
.tools{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:25px}
.tool{padding:4px 10px;border-radius:5px;background:#18151d;border:1px solid #39313d;color:#d28ac5;font-size:12px}
.project-img-container{width:100%;margin:20px 0 30px;display:flex;flex-direction:column;gap:15px}
.project-img-container img{width:100%;height:auto;display:block;border-radius:12px;border:1px solid #3b3040;box-shadow:0 6px 20px rgba(0,0,0,.4)}
.section{margin-top:25px;padding-top:20px;border-top:1px solid #302d35}
.section-title{color:#e39bd8;font-size:18px;margin-bottom:12px}
p, ul{color:#aaaab3;font-size:14px;margin-bottom:10px}
ul{padding-left:20px}
li{margin-bottom:6px}
.github-link{display:inline-block;margin-top:25px;padding:10px 20px;background:#302034;border:1px solid #b878ad;border-radius:8px;color:#e5c1e0;font-size:14px}
.github-link:hover{background:#45284b}
</style>
</head>
<body>
<div class="container">
<a href="index.html" class="back-btn">← Back to Portfolio</a>
<div class="card" id="project-content">
<h1 id="title">Loading Project...</h1>
<p id="description">Please wait while project details load.</p>
</div>
</div>

<script>
const projects = {
  "1": {
    tag: "PROJECT 01",
    title: "Auto Sales Performance Dashboard",
    images: ["images/project1-1.jpg"],
    tools: ["Excel", "Pivot Tables", "Pivot Charts", "Slicers", "KPI Reporting"],
    overview: "Built an interactive Excel dashboard analyzing $9.76M in sales and 96,428 units ordered across multiple countries and product categories.",
    keyFeatures: [
      "Total Sales, Units Sold, and Average Order Value KPI cards.",
      "Monthly sales trend analysis identifying peak sales periods.",
      "Product category distribution highlighting top-performing vehicles.",
      "Interactive slicers for filtering by Year, Country, and Deal Size."
    ],
    github: "https://github.com/nandini-data-analyst07"
  },
  "2": {
    tag: "PROJECT 02",
    title: "Spotify Streaming Analytics",
    images: ["images/project2-1.jpg"],
    tools: ["Power BI", "Data Visualization", "DAX", "KPI Cards"],
    overview: "Developed an interactive Power BI dashboard analyzing top streamed tracks, artist distributions, streaming trends, and audio feature relationships.",
    keyFeatures: [
      "Tracked total streams, song counts, and unique artists using dynamic KPI metrics.",
      "Analyzed audio features like danceability, energy, and acousticness across top hits.",
      "Designed interactive visuals allowing breakdown by release year and key parameters."
    ],
    github: "https://github.com/nandini-data-analyst07"
  },
  "3": {
    tag: "PROJECT 03",
    title: "HR Analytics Dashboard",
    images: ["images/project3-1.jpg"],
    tools: ["Excel", "Data Cleaning", "Dashboard Design", "Slicers"],
    overview: "Cleaned and transformed raw employee data into an interactive HR dashboard covering workforce distribution, status, performance, and engagement trends.",
    keyFeatures: [
      "Workforce demographics breakdown by department, gender, and employment status.",
      "Attrition and turnover tracking to highlight high-risk departments.",
      "Performance evaluation score distributions across teams."
    ],
    github: "https://github.com/nandini-data-analyst07"
  },
  "4": {
    tag: "PROJECT 04",
    title: "HR Data Cleaning Project",
    images: ["images/project4-1.jpg", "images/project4-2.jpg"],
    tools: ["Excel", "Power Query", "Data Cleaning", "Data Standardization"],
    overview: "Transformed a messy raw HR dataset into a structured, analysis-ready format by standardizing entries and resolving quality issues.",
    keyFeatures: [
      "Removed exact and conditional duplicate employee records.",
      "Handled null values and inconsistent text formatting across departments.",
      "Standardized date formats and calculated age and length of service."
    ],
    github: "https://github.com/nandini-data-analyst07"
  }
};

const params = new URLSearchParams(window.location.search);
const id = params.get('project') || "1";
const data = projects[id] || projects["1"];

document.title = data.title + " | Nandini Kumari";

let toolsHTML = data.tools.map(t => `<span class="tool">${t}</span>`).join('');
let featuresHTML = data.keyFeatures.map(f => `<li>${f}</li>`).join('');
let imagesHTML = data.images.map(imgSrc => `<img src="${imgSrc}" alt="${data.title}">`).join('');

document.getElementById('project-content').innerHTML = `
  <div class="project-tag">${data.tag}</div>
  <h1>${data.title}</h1>
  <div class="tools">${toolsHTML}</div>
  
  <div class="project-img-container">
    ${imagesHTML}
  </div>

  <div class="section">
    <div class="section-title">Project Overview</div>
    <p>${data.overview}</p>
  </div>
  
  <div class="section">
    <div class="section-title">Key Features & Analysis</div>
    <ul>${featuresHTML}</ul>
  </div>
  
  <a href="${data.github}" target="_blank" rel="noopener" class="github-link">View Project Repository on GitHub ↗</a>
`;
</script>
</body>
</html>
