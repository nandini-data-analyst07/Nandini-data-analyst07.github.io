<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Project Details | Nandini Kumari</title>

<style>

/* =========================
   BASIC SETTINGS
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;

    background:
        radial-gradient(
            circle at 20% 10%,
            #28172f 0%,
            transparent 28%
        ),
        radial-gradient(
            circle at 90% 70%,
            #21152d 0%,
            transparent 25%
        ),
        #090a0f;

    color: #eee;

    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}


/* =========================
   CONTAINER
========================= */

.container {
    max-width: 900px;
    margin: 40px auto;
    padding: 0 20px;
}


/* =========================
   BACK BUTTON
========================= */

.back-btn {
    display: inline-block;

    margin-bottom: 25px;

    padding: 8px 16px;

    background: #14131a;

    border: 1px solid #554454;

    border-radius: 8px;

    color: #e6b3df;

    font-size: 13px;
}

.back-btn:hover {
    background: #291b2b;
}


/* =========================
   PROJECT CARD
========================= */

.card {
    background: rgba(11, 12, 17, .86);

    border: 1px solid #36303b;

    border-radius: 18px;

    padding: 35px;

    box-shadow:
        0 0 35px rgba(190, 80, 200, .08);
}


/* =========================
   PROJECT TAG
========================= */

.project-tag {
    color: #96648e;

    font-size: 12px;

    letter-spacing: 1px;

    font-weight: bold;
}


/* =========================
   TITLE
========================= */

h1 {
    font-size: 32px;

    color: #e8e4e8;

    margin: 10px 0 15px;
}


/* =========================
   TOOLS
========================= */

.tools {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-bottom: 25px;
}

.tool {
    padding: 4px 10px;

    border-radius: 5px;

    background: #18151d;

    border: 1px solid #39313d;

    color: #d28ac5;

    font-size: 12px;
}


/* =========================
   PROJECT IMAGES
========================= */

.project-img-container {
    width: 100%;

    margin: 20px 0 30px;

    display: flex;

    flex-direction: column;

    gap: 15px;
}

.project-img-container img {
    width: 100%;

    height: auto;

    display: block;

    border-radius: 12px;

    border: 1px solid #3b3040;

    box-shadow:
        0 6px 20px rgba(0, 0, 0, .4);
}


/* =========================
   SECTIONS
========================= */

.section {
    margin-top: 25px;

    padding-top: 20px;

    border-top: 1px solid #302d35;
}

.section-title {
    color: #e39bd8;

    font-size: 18px;

    margin-bottom: 12px;
}

p,
ul {
    color: #aaaab3;

    font-size: 14px;

    margin-bottom: 10px;
}

ul {
    padding-left: 20px;
}

li {
    margin-bottom: 6px;
}


/* =========================
   GITHUB BUTTON
========================= */

.github-link {
    display: inline-block;

    margin-top: 25px;

    padding: 10px 20px;

    background: #302034;

    border: 1px solid #b878ad;

    border-radius: 8px;

    color: #e5c1e0;

    font-size: 14px;
}

.github-link:hover {
    background: #45284b;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {

    .container {
        margin: 20px auto;
        padding: 0 15px;
   
